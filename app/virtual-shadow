"use client";

import { useState } from "react";
import VirtualShadowRenderer from "@/components/VirtualShadowRenderer";
import LeadCapture from "@/components/LeadCapture";

export default function VirtualShadowPage() {
  const [capturedUrl, setCapturedUrl] = useState("");
  const [hasResult, setHasResult] = useState(false);

  const handleResult = (url: string) => {
    setCapturedUrl(url);
    setHasResult(true);
  };

  return (
    <main>
      <section className="bg-[#FAFAFA] py-16 sm:py-24">
        <div className="max-w-7xl mx-auto px-4 sm:px-8">
          <div className="text-center mb-12">
            <h1 className="font-heading font-black uppercase text-4xl sm:text-5xl tracking-tight leading-[0.95]">
              Virtual <span className="text-[#FF4500]">Shadow</span> Renderer
            </h1>
            <p className="mt-4 text-lg text-[#525252] max-w-2xl mx-auto">
              Zie hoe jouw website eruit zou zien als Next.js applicatie.
              Een realistische simulatie gebaseerd op honderden migraties.
            </p>
          </div>

          <VirtualShadowRenderer onResult={handleResult} />

          {hasResult && (
            <div className="mt-8 max-w-2xl mx-auto">
              <LeadCapture
                tool="virtual-shadow"
                urlTested={capturedUrl}
                title="Ontvang je volledige shadow analyse"
                description="Laat je e-mail achter en ontvang het complete migratierapport met alle metrics, tijdslijn en kosteninschatting."
                ctaText="Stuur analyse naar mijn e-mail"
              />
            </div>
          )}
        </div>
      </section>
    </main>
  );
}
