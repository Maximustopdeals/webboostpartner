"use client";

import { useState } from "react";
import MigratieSchatting from "@/components/MigratieSchatting";
import LeadCapture from "@/components/LeadCapture";

export default function MigratieSchattingPage() {
  const [capturedUrl, setCapturedUrl] = useState("");
  const [capturedData, setCapturedData] = useState<Record<string, unknown> | null>(null);

  const handleResult = (url: string, estimate: { timeline: string; costRange: number[]; pages: number; components: number; complexity: string }) => {
    setCapturedUrl(url);
    setCapturedData({
      url,
      timeline: estimate.timeline,
      costEstimate: `€${estimate.costRange[0].toLocaleString("nl-NL")} - €${estimate.costRange[1].toLocaleString("nl-NL")}`,
      pages: estimate.pages,
      components: estimate.components,
      complexity: estimate.complexity,
    });
  };

  return (
    <main>
      <section className="bg-[#FAFAFA] py-16 sm:py-24">
        <div className="max-w-7xl mx-auto px-4 sm:px-8">
          <div className="text-center mb-12">
            <h1 className="font-heading font-black uppercase text-4xl sm:text-5xl tracking-tight leading-[0.95]">
              Migratie <span className="text-[#FF4500]">Schatting</span>
            </h1>
            <p className="mt-4 text-lg text-[#525252] max-w-2xl mx-auto">
              Eén klik. Direct inzicht. Ontdek wat de overstap naar Next.js kost
              en hoe lang het duurt — zonder verplichtingen.
            </p>
          </div>

          <MigratieSchatting onResult={handleResult} />

          {capturedData && (
            <div className="mt-8 max-w-2xl mx-auto">
              <LeadCapture
                tool="migratie-schatting"
                urlTested={capturedUrl}
                resultData={capturedData}
                title="Ontvang je migratieplan"
                description="Laat je e-mail achter en ontvang een gedetailleerd migratieplan met tijdlijn, kosten en fases. We nemen binnen 24 uur contact op."
                ctaText="Stuur migratieplan naar mijn e-mail"
              />
            </div>
          )}
        </div>
      </section>
    </main>
  );
}
